    </a>
    <ul class="nav__links">
      <li><a href="<%= prefix %>/#about">Hi!</a></li>
      <li><a href="<%= prefix %>/menu">Menu</a></li>
      <li><a href="<%= prefix %>/#gallery">Shop</a></li>
      <li><a href="<%= prefix %>/#testimonials">Love</a></li>
      <li><a href="<%= prefix %>/#contact">Visit</a></li>
    </ul>
    <a href="<%= prefix %>/#contact" class="nav__cta">Say hi ✿</a>
    <button class="nav__burger" id="burger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </nav>
