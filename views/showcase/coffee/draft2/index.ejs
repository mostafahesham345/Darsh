<%- include('partials/header') %>

<!-- HERO -->
<header class="hero">
  <div class="hero__bg" style="background-image:url('<%= content.hero.image %>')"></div>
  <div class="hero__veil"></div>

  <div class="hero__content">
    <p class="eyebrow"><%= content.hero.eyebrow %></p>
    <h1 class="hero__title">
      <% content.hero.title.split(' ').forEach(function(w, i){ %>
        <span class="word" style="--i:<%= i %>"><%= w %></span>
      <% }) %>
    </h1>
    <p class="hero__sub"><%= content.hero.subtitle %></p>
    <div class="hero__ctas">
      <a href="<%= prefix %>/menu" class="btn btn--primary"><%= content.hero.ctaPrimary %><span class="btn__arrow">→</span></a>
      <a href="#contact" class="btn btn--ghost"><%= content.hero.ctaSecondary %></a>
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span>● OPEN NOW &nbsp; · &nbsp; <%= content.brand.tagline %> &nbsp; · &nbsp; SINGLE ORIGIN &nbsp; · &nbsp; PRESSURE 9 BAR &nbsp; · &nbsp; ROASTED IN-HOUSE &nbsp; · &nbsp;</span>
    <span>● OPEN NOW &nbsp; · &nbsp; <%= content.brand.tagline %> &nbsp; · &nbsp; SINGLE ORIGIN &nbsp; · &nbsp; PRESSURE 9 BAR &nbsp; · &nbsp; ROASTED IN-HOUSE &nbsp; · &nbsp;</span>
  </div>
</header>

<!-- ABOUT -->
<section class="section about" id="about">
  <div class="about__grid">
    <div class="about__text reveal">
      <p class="eyebrow"><%= content.about.eyebrow %></p>
      <h2 class="display"><%= content.about.title %></h2>
      <p class="lead"><%= content.about.body %></p>
      <div class="stats">
        <div class="stat"><span class="stat__num" data-count="<%= content.about.stat1Number %>"><%= content.about.stat1Number %></span><span class="stat__label"><%= content.about.stat1Label %></span></div>
        <div class="stat"><span class="stat__num" data-count="<%= content.about.stat2Number %>"><%= content.about.stat2Number %></span><span class="stat__label"><%= content.about.stat2Label %></span></div>
        <div class="stat"><span class="stat__num" data-count="<%= content.about.stat3Number %>"><%= content.about.stat3Number %></span><span class="stat__label"><%= content.about.stat3Label %></span></div>
      </div>
    </div>
    <div class="about__visual reveal">
      <div class="about__photo" style="background-image:url('<%= content.about.image %>')"></div>
      <div class="about__sticker"><span class="caveat">EST. 2021</span></div>
      <div class="about__ring"></div>
    </div>
  </div>
</section>

<!-- MENU PREVIEW -->
<section class="section menu-preview" id="menu">
  <div class="section__head reveal">
    <p class="eyebrow"><%= content.menuSection.eyebrow %></p>
    <h2 class="display"><%= content.menuSection.title %></h2>
    <p class="lead"><%= content.menuSection.subtitle %></p>
  </div>

  <div class="menu-grid">
    <% menu.slice(0, 6).forEach(function(item, i){ %>
      <article class="menu-card reveal" style="--d:<%= i * 60 %>ms">
        <div class="menu-card__img" style="background-image:url('<%= item.image %>')">
          <span class="menu-card__cat"><%= item.category %></span>
        </div>
        <div class="menu-card__body">
          <div class="menu-card__head">
            <h3><%= item.name %></h3>
            <span class="menu-card__price">$<%= item.price %></span>
          </div>
          <p><%= item.description %></p>
        </div>
      </article>
    <% }) %>
  </div>

  <div class="section__cta reveal">
    <a href="<%= prefix %>/menu" class="btn btn--primary">Full menu <span class="btn__arrow">→</span></a>
  </div>
</section>

<!-- GALLERY -->
<section class="section gallery" id="gallery">
  <div class="section__head reveal">
    <p class="eyebrow"><%= content.gallery.eyebrow %></p>
    <h2 class="display"><%= content.gallery.title %></h2>
    <p class="lead"><%= content.gallery.subtitle %></p>
  </div>
  <div class="gallery__grid">
    <% content.gallery.images.forEach(function(src, i){ %>
      <div class="gallery__item reveal" style="--d:<%= i * 50 %>ms">
        <img src="<%= src %>" alt="Inside <%= content.brand.name %> — photo <%= i + 1 %> of <%= content.gallery.images.length %>" loading="lazy" decoding="async" />
      </div>
    <% }) %>
  </div>
</section>

<!-- TESTIMONIALS -->
<section class="section testimonials" id="testimonials">
  <div class="section__head reveal">
    <p class="eyebrow"><%= content.testimonials.eyebrow %></p>
    <h2 class="display"><%= content.testimonials.title %></h2>
  </div>
  <div class="testimonials__grid">
    <% content.testimonials.items.forEach(function(t, i){ %>
      <figure class="testimonial reveal" style="--d:<%= i * 90 %>ms">
        <span class="testimonial__quote">&ldquo;</span>
        <blockquote><%= t.quote %></blockquote>
        <figcaption>
          <strong><%= t.name %></strong>
          <span><%= t.role %></span>
        </figcaption>
      </figure>
    <% }) %>
  </div>
</section>

<!-- CONTACT -->
<section class="section contact" id="contact">
  <div class="contact__grid">
    <div class="contact__info reveal">
      <p class="eyebrow"><%= content.contact.eyebrow %></p>
      <h2 class="display"><%= content.contact.title %></h2>
      <ul class="contact__list">
        <li><span class="contact__icon">ADDRESS</span><div><strong>Find us</strong><p><%= content.contact.address %></p></div></li>
        <li><span class="contact__icon">HOURS</span><div><strong>Hours</strong><p><%- (content.contact.hours || '').replace(/\n/g, '<br/>') %></p></div></li>
        <li><span class="contact__icon">PHONE</span><div><strong>Call</strong><p><%= content.contact.phone %></p></div></li>
        <li><span class="contact__icon">EMAIL</span><div><strong>Email</strong><p><%= content.contact.email %></p></div></li>
        <li><span class="contact__icon">IG</span><div><strong>Instagram</strong><p><%= content.contact.instagram %></p></div></li>
      </ul>
    </div>
    <div class="contact__map reveal">
      <iframe src="<%= content.contact.mapEmbed %>" loading="lazy" title="map"></iframe>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
