<%- include('partials/header') %>

<section class="menu-page">
  <header class="section-head">
    <p class="eyebrow"><%= content.menuSection.eyebrow %></p>
    <h1><%= content.menuSection.title %></h1>
    <p class="muted"><%= content.menuSection.subtitle %></p>
  </header>

  <% const groups = {}; menu.forEach(function(m){ (groups[m.category] = groups[m.category] || []).push(m); }); %>
  <% Object.keys(groups).forEach(function(g){ %>
    <section class="menu-group">
      <h2 class="menu-group__title"><%= g %></h2>
      <div class="menu-group__grid">
        <% groups[g].forEach(function(item){ %>
          <article class="dish dish--list">
            <div class="dish__img"><img src="<%= item.image %>" alt="<%= item.name %>" /></div>
            <div class="dish__body">
              <h3><%= item.name %></h3>
              <p><%= item.description %></p>
              <p class="dish__price">$<%= item.price %></p>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
  <% }) %>
</section>

<%- include('partials/footer') %>
