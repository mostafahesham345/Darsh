<%- include('partials/header') %>

<section class="bru-hero">
  <div class="bru-hero__grid">
    <div class="bru-hero__num">01</div>
    <div class="bru-hero__copy">
      <p class="bru-eyebrow"><%= content.hero.eyebrow %></p>
      <h1><%= content.hero.title %></h1>
    </div>
    <div class="bru-hero__sub">
      <p><%= content.hero.subtitle %></p>
      <div class="bru-hero__cta">
        <a href="<%= prefix %>/menu" class="bru-btn">→ <%= content.hero.ctaPrimary %></a>
        <a href="<%= prefix %>/#visit" class="bru-btn bru-btn--ghost">→ <%= content.hero.ctaSecondary %></a>
      </div>
    </div>
    <div class="bru-hero__img">
      <img src="<%= content.hero.image %>" alt="<%= content.brand.name %> — <%= content.hero.eyebrow %>" decoding="async" />
      <span class="bru-hero__sticker"><%= content.hero.sticker %></span>
    </div>
  </div>
</section>

<section class="bru-strip">
  <% (content.strip.items || []).forEach(function(s, i){ %>
    <span><%= String(i+1).padStart(2,'0') %> · <%= s.toUpperCase() %></span>
  <% }) %>
</section>

<section class="bru-block">
  <div class="bru-block__num">02</div>
  <h2 class="bru-block__title"><%= content.featured.title.toUpperCase() %></h2>
  <p class="bru-block__sub"><%= content.featured.subtitle %></p>
  <div class="bru-items">
    <% menu.slice(0, 6).forEach(function(item, i){ %>
      <article class="bru-item">
        <div class="bru-item__num"><%= String(i+1).padStart(2,'0') %></div>
        <div class="bru-item__img"><img src="<%= item.image %>" alt="<%= item.name %>" loading="lazy" decoding="async" /></div>
        <div class="bru-item__body">
          <p class="bru-item__cat">// <%= item.category.toUpperCase() %></p>
          <h3><%= item.name %></h3>
          <p><%= item.description %></p>
          <p class="bru-item__price">$<%= item.price %></p>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<section id="about" class="bru-band">
  <div class="bru-band__num">03 · ABOUT</div>
  <div class="bru-band__grid">
    <div class="bru-band__copy">
      <p class="bru-eyebrow"><%= content.about.eyebrow %></p>
      <h2><%= content.about.title %></h2>
      <p><%= content.about.body %></p>
    </div>
    <div class="bru-band__stats">
      <div><strong><%= content.about.stat1Number %></strong><span><%= content.about.stat1Label %></span></div>
      <div><strong><%= content.about.stat2Number %></strong><span><%= content.about.stat2Label %></span></div>
      <div><strong><%= content.about.stat3Number %></strong><span><%= content.about.stat3Label %></span></div>
    </div>
  </div>
</section>

<section id="visit" class="bru-block">
  <div class="bru-block__num">04</div>
  <h2 class="bru-block__title"><%= content.contact.title.toUpperCase() %></h2>
  <div class="bru-visit">
    <div>
      <p class="bru-visit__label">// ADDRESS</p>
      <p class="bru-visit__value"><%= content.contact.address %></p>
    </div>
    <div>
      <p class="bru-visit__label">// HOURS</p>
      <p class="bru-visit__value" style="white-space: pre-line;"><%= content.contact.hours %></p>
    </div>
    <div>
      <p class="bru-visit__label">// CONTACT</p>
      <p class="bru-visit__value"><%= content.contact.phone %></p>
      <p class="bru-visit__value"><%= content.contact.email %></p>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
