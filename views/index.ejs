<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0a1f44" />
  <title><%= content.meta.fields.title %></title>
  <meta name="description" content="<%= content.meta.fields.description %>" />
  <link rel="icon" type="image/png" href="<%= content.meta.images.favicon.url %>" />

  <%
    // Absolute URLs for sharing / SEO. BASE_URL is per-environment (a LAN IP in
    // dev, the real domain on Render) so nothing is hardcoded here.
    // TODO: cleaner would be a single `app.locals.baseUrl` set in server.js and
    // used by every view; server.js is outside the scope of this change, so the
    // env var is read directly for now.
    var baseUrl = (process.env.BASE_URL || '').replace(/\/+$/, '');
    function absUrl(u) {
      if (!u) return '';
      return /^https?:\/\//i.test(u) ? u : baseUrl + (u.charAt(0) === '/' ? u : '/' + u);
    }
    var pageUrl = baseUrl + '/';
    var brandName = process.env.BUSINESS_NAME || content.footer.fields.brandName || 'Darsh';
    var shareImagePath = process.env.BUSINESS_LOGO_URL || content.meta.images.favicon.url || '/images/Logo.png';
    var shareImage = absUrl(shareImagePath);
    // Only the bundled logo has known intrinsic dimensions (500×500).
    var shareImageIsLogo = /\/Logo\.png$/i.test(shareImagePath);
  %>

  <link rel="canonical" href="<%= pageUrl %>" />

  <!-- Open Graph (Facebook, LinkedIn, WhatsApp, Slack…) -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="<%= brandName %>" />
  <meta property="og:title" content="<%= content.meta.fields.title %>" />
  <meta property="og:description" content="<%= content.meta.fields.description %>" />
  <meta property="og:url" content="<%= pageUrl %>" />
  <meta property="og:image" content="<%= shareImage %>" />
  <meta property="og:image:alt" content="<%= brandName %> logo" />
  <% if (shareImageIsLogo) { %>
  <meta property="og:image:width" content="500" />
  <meta property="og:image:height" content="500" />
  <% } %>

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= content.meta.fields.title %>" />
  <meta name="twitter:description" content="<%= content.meta.fields.description %>" />
  <meta name="twitter:image" content="<%= shareImage %>" />
  <meta name="twitter:image:alt" content="<%= brandName %> logo" />

  <%
    // Structured data — driven by the same CMS content as the tags above, but
    // BUILT in lib/seo.js. The view only hands over data and serialises the
    // result; which schema types are emitted (and which are deliberately not)
    // is documented there, next to the code that decides it.
    //
    // Loading the module: an EJS template can't `import`, and the clean home
    // for this is one line in server.js — `app.locals.seo = seo` — which is
    // outside the scope of this change. So a `seo` local is preferred if a
    // route ever supplies one, and otherwise the module is required directly
    // off the views dir (settings.views is set by server.js). Wrapped in
    // try/catch: missing structured data is a bad day for SEO, a 500 on the
    // homepage is a worse one.
    var seoLib = (typeof seo !== 'undefined' && seo) ? seo : (function () {
      try {
        var createRequire = process.getBuiltinModule('module').createRequire;
        return createRequire(String(settings.views) + '/index.ejs')('../lib/seo.js');
      } catch (err) {
        console.warn('[index] structured data unavailable:', err.message);
        return null;
      }
    })();

    var contactEmail = process.env.CONTACT_EMAIL || process.env.ADMIN_EMAIL || '';
    var approvedReviews = (typeof reviews !== 'undefined' && Array.isArray(reviews)) ? reviews : [];
    // Aggregate of the approved reviews this page renders — null when there
    // are none, and nothing is claimed in that case. Also drives the visible
    // rating line in the #reviews section, so the markup always matches
    // something a human can read on the page.
    var reviewSummary = seoLib ? seoLib.summarizeReviews(approvedReviews) : null;
    var servicePageSlugs = seoLib ? seoLib.SERVICE_PAGE_SLUGS : [];
    var linkedServices = (typeof services !== 'undefined' && Array.isArray(services))
      ? services.filter(function (s) { return s && servicePageSlugs.indexOf(s.slug) !== -1; })
      : [];
  %>
  <% if (seoLib) { %>
  <script type="application/ld+json">
    <%- seoLib.serializeJsonLd(seoLib.buildHomepageGraph({
      baseUrl: baseUrl,
      brandName: brandName,
      description: content.meta.fields.description,
      slogan: process.env.BUSINESS_TAGLINE || content.footer.fields.brandTagline,
      logoUrl: shareImage,
      contactEmail: contactEmail,
      sameAs: seoLib.collectSameAs(content.footer),
      services: (typeof services !== 'undefined' && services) || [],
      reviewSummary: reviewSummary,
    })) %>
  </script>
  <% } %>

  <!-- Largest visible element on the page — fetch it as early as possible. -->
  <link rel="preload" as="image" href="/images/BackgroundPic.webp" fetchpriority="high" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <link rel="stylesheet" href="/css/landing.css" />

  <!--
    Two small additions that belong with this change: the internal-link row
    under the services grid, and the visible rating line that backs the
    AggregateRating markup. Scoped here rather than in public/css/landing.css
    because that file is being edited elsewhere this session — move these into
    it (next to the SERVICES SHOWCASE / REVIEWS blocks) when things settle.
  -->
  <style>
    .svc-links {
      display: flex; flex-wrap: wrap; justify-content: center; align-items: center;
      gap: 8px; margin-top: 36px;
    }
    .svc-links__label {
      font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--ink-mute); margin-right: 4px;
    }
    .svc-links a {
      font-size: 0.86rem; font-weight: 600; color: var(--ink);
      background: #fff; border: 1px solid var(--line-strong); border-radius: 99px;
      padding: 7px 14px; line-height: 1.2;
      transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s var(--easing);
    }
    .svc-links a:hover { background: var(--navy); color: var(--soft); border-color: var(--navy); transform: translateY(-1px); }
    .svc-links a.svc-links__all { background: var(--navy); color: var(--soft); border-color: var(--navy); }
    .svc-links a.svc-links__all:hover { background: var(--navy-2); border-color: var(--navy-2); }
    @media (max-width: 600px) { .svc-links a { font-size: 0.8rem; padding: 6px 12px; } }

    .reviews-aggregate {
      display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
      gap: 10px; margin-top: 18px; font-size: 0.95rem; color: var(--ink-soft);
    }
    .reviews-aggregate .review-stars { font-size: 1rem; }
    .reviews-aggregate strong { color: var(--ink); font-size: 1.05rem; }
  </style>
</head>
<body>

  <div class="cursor-glow" aria-hidden="true"></div>

  <!-- NAV -->
  <%- include('partials/nav', { content, home: true }) %>

  <%
    var brandLogos = (content.brands && Array.isArray(content.brands.items))
      ? content.brands.items.filter(function (b) { return b && b.image && b.image.url; })
      : [];
  %>

  <!-- HERO -->
  <section class="hero" id="top">
    <div class="hero-bg" style="background-image: url('/images/BackgroundPic.webp');"></div>
    <div class="hero-bg-veil"></div>
    <div class="hero-bg-grid"></div>

    <span class="blob blob-1" aria-hidden="true"></span>
    <span class="blob blob-2" aria-hidden="true"></span>
    <span class="blob blob-3" aria-hidden="true"></span>

    <div class="hero-inner">
      <span class="hero-badge reveal" data-cms="hero.fields.badge">
        <span class="hero-badge-dot"></span>
        <%= content.hero.fields.badge %>
      </span>

      <h1 class="hero-title reveal">
        <span data-cms="hero.fields.titleLine1"><%= content.hero.fields.titleLine1 %></span>
        <br />
        <span data-cms="hero.fields.titleLine2"><%= content.hero.fields.titleLine2 %></span>
        <span class="hero-title-grad" data-cms="hero.fields.titleAccent"><%= content.hero.fields.titleAccent %></span><span data-cms="hero.fields.titleSuffix"><%= content.hero.fields.titleSuffix %></span>
      </h1>

      <p class="hero-sub reveal" data-cms="hero.fields.sub">
        <%= content.hero.fields.sub %>
      </p>

      <div class="hero-cta reveal">
        <a href="<%= content.hero.links.primaryCta.href %>" class="btn btn-primary btn-glow">
          <span data-cms="hero.links.primaryCta.label"><%= content.hero.links.primaryCta.label %></span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
        </a>
        <a href="<%= content.hero.links.secondaryCta.href %>" class="btn btn-ghost" data-cms="hero.links.secondaryCta.label">
          <%= content.hero.links.secondaryCta.label %>
        </a>
      </div>

      <div class="hero-kpis reveal">
        <% (content.hero.kpis || []).forEach(function(kpi, idx) { %>
          <% if (idx > 0) { %><div class="kpi-sep"></div><% } %>
          <div class="kpi">
            <div class="kpi-value" data-count="<%= kpi.value %>"<% if (kpi.suffix) { %> data-suffix="<%= kpi.suffix %>"<% } %>>0</div>
            <div class="kpi-label"><%= kpi.label %></div>
          </div>
        <% }); %>
      </div>

      <% if (brandLogos.length) { %>
      <div class="hero-brands reveal" id="brands">
        <span class="hero-brands__label"><%= (content.brands.fields && content.brands.fields.title) || 'Trusted by' %></span>
        <div class="hero-brands__marquee">
          <div class="hero-brands__group">
            <% brandLogos.forEach(function(b) { %><span class="hero-brand"><img src="<%= b.image.url %>" alt="<%= b.name ? b.name + ' logo' : '' %>" loading="lazy" decoding="async" /></span><% }); %>
          </div>
          <div class="hero-brands__group" aria-hidden="true">
            <% brandLogos.forEach(function(b) { %><span class="hero-brand"><img src="<%= b.image.url %>" alt="" loading="lazy" decoding="async" /></span><% }); %>
          </div>
        </div>
      </div>
      <% } %>
    </div>

  </section>

  <!-- WHAT WE DO (services) -->
  <section class="section section-yellow" id="services">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow"><%= servicesMeta.eyebrow %></span>
        <h2><%= servicesMeta.title %></h2>
        <p class="lede"><%= servicesMeta.lede %></p>
      </div>

      <%- include('partials/services-grid', { services }) %>

      <%
        /*
         * Internal links to the standalone service pages.
         *
         * These sit next to the grid rather than inside the cards because the
         * card markup lives in views/partials/services-grid.ejs, which is
         * shared with the /services page and is being edited elsewhere this
         * session — wrapping each card in an <a> from here would collide (and
         * risk nesting anchors if that partial gains its own links).
         * Crawl-wise this does the same job: descriptive anchor text, one link
         * per published service, plus the hub. Once the partial settles, the
         * ideal shape is the card title itself linking to /services/<slug> and
         * this row reducing to the single "All services" link.
         */
      %>
      <% if (linkedServices.length) { %>
      <nav class="svc-links reveal" aria-label="Service pages">
        <span class="svc-links__label">Read more:</span>
        <% linkedServices.forEach(function (s) { %>
          <a href="/services/<%= s.slug %>"><%= s.title %></a>
        <% }); %>
        <a href="/services" class="svc-links__all">All services</a>
      </nav>
      <% } %>

      <div class="svc-cta reveal">
        <a href="#contact" class="btn btn-dark btn-glow">
          <span>Start a project</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- WHAT WE CAN DO FOR YOU (Why Darsh) -->
  <%- include('partials/discover-designs') %>

  <!-- PROCESS -->
  <section class="section process-section" id="process">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow" data-cms="process.fields.eyebrow"><%= content.process.fields.eyebrow %></span>
        <h2 data-cms="process.fields.title"><%= content.process.fields.title %></h2>
        <p class="lede" data-cms="process.fields.lede">
          <%= content.process.fields.lede %>
        </p>
      </div>

      <div class="process">
        <% (content.process.steps || []).forEach(function(step, idx) { %>
          <div class="process-step reveal">
            <div class="process-num"><%= step.num %></div>
            <h3><%= step.title %></h3>
            <p><%= step.description %></p>
          </div>
          <% if (idx < (content.process.steps.length - 1)) { %>
            <div class="process-line"><span class="process-line-fill"></span></div>
          <% } %>
        <% }); %>
      </div>

      <div class="process-cta reveal">
        <a href="<%= content.process.fields.ctaHref %>" class="btn btn-dark btn-glow">
          <span><%= content.process.fields.ctaLabel %></span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section class="section section-yellow" id="work">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow" data-cms="work.fields.eyebrow"><%= content.work.fields.eyebrow %></span>
        <h2 data-cms="work.fields.title"><%= content.work.fields.title %></h2>
        <p class="lede" data-cms="work.fields.lede"><%= content.work.fields.lede %></p>
      </div>

      <div class="work-grid">
        <%
          function normalizeUrl(u) {
            const s = (u || '').trim();
            if (!s) return '';
            return /^https?:\/\//i.test(s) ? s : 'https://' + s.replace(/^\/+/, '');
          }
          function displayUrl(u) {
            try { return new URL(normalizeUrl(u)).host; } catch (_) { return (u || '').replace(/^https?:\/\//, ''); }
          }
          function shotUrl(u) {
            const full = normalizeUrl(u);
            if (!full) return '/images/placeholder.svg';
            return 'https://api.microlink.io/?url=' + encodeURIComponent(full) + '&screenshot=true&meta=false&embed=screenshot.url&viewport.width=1280&viewport.height=800';
          }
          function previewUrl(card) {
            if (card && card.image && card.image.url) return card.image.url;
            return shotUrl(card && card.url);
          }
        %>
        <% (content.work.cards || []).forEach(function(card, idx) { %>
          <a href="<%= card.url %>" target="_blank" rel="noopener" class="work-card reveal">
            <div class="work-frame">
              <div class="work-frame-bar">
                <span></span><span></span><span></span>
                <span class="work-frame-url"><%= displayUrl(card.url) %></span>
              </div>
              <div class="work-frame-shot">
                <img src="<%= previewUrl(card) %>" alt="Screenshot of the <%= card.title %> website built by <%= brandName %>" loading="lazy" decoding="async" onerror="this.parentElement.classList.add('shot-error')" />
                <div class="work-shot-fallback">preview unavailable</div>
              </div>
              <div class="work-overlay">
                <span class="work-visit">
                  Visit site
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
                </span>
              </div>
            </div>
            <div class="work-meta">
              <div class="work-meta-row">
                <h3><%= card.title %></h3>
                <span class="work-arrow">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
                </span>
              </div>
              <p><%= card.description %></p>
              <div class="work-tags">
                <% (card.tags || []).forEach(function(t) { %><span class="work-tag"><%= t %></span><% }); %>
              </div>
            </div>
          </a>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- REVIEWS + LEAVE A REVIEW (one section) -->
  <section class="section reviews-section" id="reviews">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Reviews</span>
        <h2>Loved by the people we build for</h2>
        <p class="lede">See what our clients say — and if you've worked with us, add your own.</p>

        <%
          /*
           * The visible half of the AggregateRating markup in <head>. Google
           * requires the rating it reads to be readable on the page too, and
           * this is computed from the very same approved reviews the carousel
           * below renders — so the two can never drift. No reviews, no line:
           * there is nothing to average and nothing is claimed.
           */
        %>
        <% if (reviewSummary) { %>
        <p class="reviews-aggregate">
          <span class="review-stars" aria-hidden="true"><% for (var si = 1; si <= 5; si++) { %><span class="<%= si <= Math.round(reviewSummary.average) ? 'on' : '' %>">★</span><% } %></span>
          <span>
            <strong><%= reviewSummary.average.toFixed(1) %></strong> out of 5
            from <%= reviewSummary.count %> client review<%= reviewSummary.count === 1 ? '' : 's' %>
          </span>
        </p>
        <% } %>
      </div>

      <div class="reviews-layout<%= (reviews && reviews.length) ? '' : ' reviews-layout--solo' %>">
        <% if (reviews && reviews.length) { %>
        <div class="reviews-say reveal">
          <div class="reviews-carousel" data-reviews-carousel>
            <button type="button" class="rc-arrow rc-prev" aria-label="Previous review">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <div class="rc-viewport">
              <div class="rc-track">
                <% reviews.forEach(function(r) { %>
                  <div class="rc-slide">
                    <article class="review-card">
                      <div class="review-stars" aria-label="<%= r.rating %> out of 5">
                        <% for (var i = 1; i <= 5; i++) { %><span class="<%= i <= r.rating ? 'on' : '' %>">★</span><% } %>
                      </div>
                      <p class="review-text">“<%= r.text %>”</p>
                      <div class="review-author">
                        <strong><%= r.name %></strong>
                        <% if (r.role) { %><span><%= r.role %></span><% } %>
                      </div>
                    </article>
                  </div>
                <% }); %>
              </div>
            </div>
            <button type="button" class="rc-arrow rc-next" aria-label="Next review">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </button>
            <div class="rc-dots">
              <% reviews.forEach(function(r, i) { %><button type="button" class="rc-dot<%= i === 0 ? ' on' : '' %>" data-i="<%= i %>" aria-label="Go to review <%= i + 1 %>"></button><% }); %>
            </div>
          </div>
        </div>
        <% } %>

        <div class="review-form-card reveal">
          <h3 class="rf-title">Leave a review</h3>
          <p class="rf-sub">Worked with us? Tell the world — checked before it goes live.</p>
          <form class="review-form" id="reviewForm" method="post" action="/reviews" novalidate>
            <div class="field">
              <label>Your rating</label>
              <div class="star-input">
                <input type="radio" id="star5" name="rating" value="5" /><label for="star5" title="5 stars">★</label>
                <input type="radio" id="star4" name="rating" value="4" /><label for="star4" title="4 stars">★</label>
                <input type="radio" id="star3" name="rating" value="3" /><label for="star3" title="3 stars">★</label>
                <input type="radio" id="star2" name="rating" value="2" /><label for="star2" title="2 stars">★</label>
                <input type="radio" id="star1" name="rating" value="1" /><label for="star1" title="1 star">★</label>
              </div>
              <span class="field-err" data-err="rating"></span>
            </div>
            <div class="rf-row">
              <div class="field">
                <label for="rv-name">Name</label>
                <input id="rv-name" name="name" type="text" placeholder="Jane Doe" required />
                <span class="field-err" data-err="name"></span>
              </div>
              <div class="field">
                <label for="rv-role">Company <span style="opacity:.55;">(optional)</span></label>
                <input id="rv-role" name="role" type="text" placeholder="Acme Inc." />
              </div>
            </div>
            <div class="field">
              <label for="rv-text">Your review</label>
              <textarea id="rv-text" name="text" rows="3" placeholder="What was it like working with us?" required></textarea>
              <span class="field-err" data-err="text"></span>
            </div>
            <div class="hp-field" aria-hidden="true">
              <label for="rv-website">Website</label>
              <input id="rv-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <button type="submit" class="btn btn-dark btn-glow btn-block" id="reviewSubmit">
              <span class="btn-label">Submit review</span>
            </button>
            <p class="contact-status" id="reviewStatus" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section-contact" id="contact">
    <div class="stars" aria-hidden="true"></div>
    <div class="container">
      <div class="contact-card reveal">
        <span class="eyebrow eyebrow-light" data-cms="contact.fields.eyebrow"><%= content.contact.fields.eyebrow %></span>
        <h2 class="text-light" data-cms="contact.fields.title"><%= content.contact.fields.title %></h2>
        <p class="lede lede-light" data-cms="contact.fields.lede"><%= content.contact.fields.lede %></p>

        <form class="contact-form" id="contactForm" method="post" action="/contact" novalidate>
          <div class="contact-row">
            <div class="field">
              <label for="cf-name">Name</label>
              <input id="cf-name" name="name" type="text" placeholder="Jane Doe" autocomplete="name" required />
              <span class="field-err" data-err="name"></span>
            </div>
            <div class="field">
              <label for="cf-email">Email</label>
              <input id="cf-email" name="email" type="email" placeholder="jane@company.com" autocomplete="email" required />
              <span class="field-err" data-err="email"></span>
            </div>
          </div>
          <div class="field">
            <label for="cf-company">Company</label>
            <input id="cf-company" name="company" type="text" placeholder="Acme, Inc." autocomplete="organization" />
          </div>
          <div class="field">
            <label for="cf-msg">What are you building?</label>
            <textarea id="cf-msg" name="message" placeholder="A quick sketch of the problem, the timeline, and what success looks like." required></textarea>
            <span class="field-err" data-err="message"></span>
          </div>

          <!-- Honeypot: hidden from humans, catches bots -->
          <div class="hp-field" aria-hidden="true">
            <label for="cf-website">Website</label>
            <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <button type="submit" class="btn btn-yellow btn-glow btn-block" id="contactSubmit">
            <span class="btn-label"><%= content.contact.fields.submitLabel %></span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
          </button>

          <p class="contact-status" id="contactStatus" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <%- include('partials/footer', { content, home: true }) %>

  <% if (typeof previewBanner !== 'undefined' && previewBanner) { %>
    <div class="preview-banner"><%= previewBanner %></div>
    <style>body { padding-top: 36px; }</style>
  <% } %>

  <% if (firebaseWebConfig && firebaseReady) { %>
    <script>window.__FIREBASE_WEB__ = <%- JSON.stringify(firebaseWebConfig) %>;</script>
    <script type="module" src="/js/cms-live.js"></script>
  <% } %>

  <script src="/js/landing.js" defer></script>
</body>
</html>
