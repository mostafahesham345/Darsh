<%
  function fHref(h) { return (!home && h && h.charAt(0) === '#') ? '/' + h : h; }

  /*
   * The footer is on every page, so it is the cheapest sitewide link to the
   * services hub at /services — that is how the standalone service pages get
   * crawled and how link authority reaches them.
   *
   * Appended rather than hardcoded into lib/defaults.js so the CMS stays the
   * source of truth for the rest of the row, and skipped entirely if an editor
   * has already added a /services link, so the two can't duplicate. Note the
   * existing "Services" entry points at the #services anchor on the homepage,
   * which is a different destination — hence the distinct label.
   */
  var footerLinks = (content.footer.links || []).slice();
  var hasServicesLink = footerLinks.some(function (l) {
    return l && typeof l.href === 'string' && /^\/services(\/|$)/.test(l.href.trim());
  });
  if (!hasServicesLink) footerLinks.push({ label: 'All services', href: '/services' });
%>
<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src="<%= content.footer.images.logo.url %>" alt="" aria-hidden="true" width="<%= content.footer.images.logo.width || 500 %>" height="<%= content.footer.images.logo.height || 500 %>" loading="lazy" decoding="async" />
      <div>
        <div class="footer-brand-name" data-cms="footer.fields.brandName"><%= content.footer.fields.brandName %></div>
        <div class="footer-brand-sub" data-cms="footer.fields.brandTagline"><%= content.footer.fields.brandTagline %></div>
      </div>
    </div>

    <nav class="footer-links">
      <% footerLinks.forEach(function(link) { %>
        <a href="<%= fHref(link.href) %>"><%= link.label %></a>
      <% }); %>
    </nav>

    <div class="footer-meta">
      © <span id="year"><%= content.meta.fields.year %></span> <%= content.footer.fields.copyright %>
    </div>
  </div>
</footer>
