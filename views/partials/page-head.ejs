<%
  /*
   * Shared <head> for standalone (non-home) pages.
   *
   * views/index.ejs builds its own head inline; this partial mirrors that same
   * pattern — canonical + Open Graph + Twitter driven off BASE_URL — so a
   * sub-page shares a link preview and a favicon with the home page instead of
   * inventing its own. It deliberately does NOT emit Organization or
   * LocalBusiness JSON-LD: that is site-wide structured data and belongs on the
   * home page only, so search engines see exactly one definition of the org.
   *
   * Locals:
   *   content         full CMS content object (for favicon + brand fallbacks)
   *   pageTitle       <title> / og:title / twitter:title
   *   pageDescription meta description / og:description / twitter:description
   *   pagePath        absolute path on this site, e.g. '/services/client-portals'
   *   jsonLd          (optional) array of schema.org objects to emit
   *
   * TODO: index.ejs, review.ejs and this file each recompute `baseUrl` from the
   * env. The clean fix is one `app.locals.baseUrl` set in server.js; that file
   * is outside the scope of this change.
   */
  var baseUrl = (process.env.BASE_URL || '').replace(/\/+$/, '');
  function absUrl(u) {
    if (!u) return '';
    return /^https?:\/\//i.test(u) ? u : baseUrl + (u.charAt(0) === '/' ? u : '/' + u);
  }
  var pageUrl = baseUrl + pagePath;
  var brandName = process.env.BUSINESS_NAME || content.footer.fields.brandName || 'Darsh';
  var faviconUrl = (content.meta.images.favicon && content.meta.images.favicon.url) || '/images/Logo.png';
  var shareImagePath = process.env.BUSINESS_LOGO_URL || faviconUrl;
  var shareImage = absUrl(shareImagePath);
  // Only the bundled logo has known intrinsic dimensions (500×500).
  var shareImageIsLogo = /\/Logo\.png$/i.test(shareImagePath);
  var structured = (typeof jsonLd !== 'undefined' && Array.isArray(jsonLd)) ? jsonLd : [];
%>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0a1f44" />
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDescription %>" />
  <link rel="icon" type="image/png" href="<%= faviconUrl %>" />

  <link rel="canonical" href="<%= pageUrl %>" />

  <!-- Open Graph (Facebook, LinkedIn, WhatsApp, Slack…) -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="<%= brandName %>" />
  <meta property="og:title" content="<%= pageTitle %>" />
  <meta property="og:description" content="<%= pageDescription %>" />
  <meta property="og:url" content="<%= pageUrl %>" />
  <meta property="og:image" content="<%= shareImage %>" />
  <meta property="og:image:alt" content="<%= brandName %> logo" />
  <% if (shareImageIsLogo) { %>
  <meta property="og:image:width" content="500" />
  <meta property="og:image:height" content="500" />
  <% } %>

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= pageTitle %>" />
  <meta name="twitter:description" content="<%= pageDescription %>" />
  <meta name="twitter:image" content="<%= shareImage %>" />
  <meta name="twitter:image:alt" content="<%= brandName %> logo" />

  <% structured.forEach(function (node) { %>
  <script type="application/ld+json">
    <%- JSON.stringify(node).replace(/</g, '\\u003c') %>
  </script>
  <% }); %>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <link rel="stylesheet" href="/css/landing.css" />
</head>
